local function escape(s) return (s:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0")) end
local WORD = "[%w\128-\255]"
local FMT = "%%[%.%d]*[dsf]"

local rules = {}
for _, e in D do
	local es, en = e[1], e[2]
	if es:find(FMT) then
		-- plantilla: cada %d/%s/%.1f se convierte en una captura
		local pat, n, i = "", 0, 1
		while i <= #es do
			local a, b = es:find(FMT, i)
			local pp = es:find("%%%%", i, false)
			if pp and (not a or pp < a) then
				pat ..= escape(es:sub(i, pp - 1)) .. "%%"
				i = pp + 2
			elseif a then
				pat ..= escape(es:sub(i, a - 1))
				local kind = es:sub(b, b)
				local last = b == #es
				pat ..= kind == "s" and (last and "([^\n<]*)" or "(.-)") or "(%-?[%d%.]+)"
				n += 1
				i = b + 1
			else
				pat ..= escape(es:sub(i))
				break
			end
		end
		local rep, k = "", 0
		local j = 1
		while j <= #en do
			local a, b = en:find(FMT, j)
			local pp = en:find("%%%%", j, false)
			if pp and (not a or pp < a) then
				rep ..= en:sub(j, pp - 1):gsub("%%", "%%%%") .. "%%"
				j = pp + 2
			elseif a then
				k += 1
				rep ..= en:sub(j, a - 1):gsub("%%", "%%%%") .. "%" .. k
				j = b + 1
			else
				rep ..= en:sub(j):gsub("%%", "%%%%")
				break
			end
		end
		table.insert(rules, { len = #es + 1000, pat = pat, rep = rep })
	else
		local pat = escape(es)
		if es:sub(1, 1):find(WORD) then pat = "%f" .. WORD .. pat end
		if es:sub(-1):find(WORD) then pat ..= "%f[^%w\128-\255]" end
		table.insert(rules, { len = #es, pat = pat, rep = (en:gsub("%%", "%%%%")) })
	end
end
-- plantillas primero, luego frases de más larga a más corta
table.sort(rules, function(a, b) return a.len > b.len end)

local cache, cacheN = {}, 0
function I.toEnglish(s)
	if type(s) ~= "string" or s == "" then return s end
	local c = cache[s]
	if c then return c end
	local out = s
	if out:find("[%a\128-\255]") then
		for _, r in rules do
			if out:find(r.pat) then out = out:gsub(r.pat, r.rep) end
		end
	end
	cacheN += 1
	if cacheN > 4000 then cache, cacheN = {}, 0 end
	cache[s] = out
	return out
end

return I
